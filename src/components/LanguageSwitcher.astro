---
/**
 * Language is part of the URL: each option is a real link to the same
 * page in another language, so crawlers reach every version.
 */
import { LOCALES, LOCALE_LABELS, pathFor, type Locale } from '../i18n';
interface Props { locale: Locale; page?: string }
const { locale, page = '' } = Astro.props;
---

<div class="lang" data-lang>
  <button type="button" class="trigger" aria-expanded="false" aria-haspopup="listbox" aria-label={LOCALE_LABELS[locale]}>
    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
      <circle cx="12" cy="12" r="10" /><path d="M2 12h20M12 2a15.3 15.3 0 0 1 0 20M12 2a15.3 15.3 0 0 0 0 20" />
    </svg>
    <span>{locale}</span>
  </button>
  <ul class="menu" role="listbox" hidden>
    {LOCALES.map((l) => (
      <li>
        <a href={pathFor(l, page)} lang={l} hreflang={l} role="option" aria-selected={l === locale} class:list={{ active: l === locale }}>
          {LOCALE_LABELS[l]}<small>{l}</small>
        </a>
      </li>
    ))}
  </ul>
</div>

<script>
  for (const root of document.querySelectorAll<HTMLElement>('[data-lang]')) {
    const trigger = root.querySelector('button')!;
    const menu = root.querySelector('ul')!;
    const setOpen = (open: boolean) => {
      menu.hidden = !open;
      trigger.setAttribute('aria-expanded', String(open));
    };
    trigger.addEventListener('click', () => setOpen(menu.hidden));
    document.addEventListener('pointerdown', (e) => {
      if (!root.contains(e.target as Node)) setOpen(false);
    });
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });
  }
</script>

<style>
  .lang { position: relative; }
  .trigger {
    display: flex; align-items: center; gap: 6px; height: 40px; padding: 0 10px;
    background: none; border: 0; cursor: pointer; font: inherit; font-size: 14px; font-weight: 600;
    color: var(--muted); text-transform: uppercase; border-radius: 12px;
  }
  .trigger:hover { color: var(--fg); }
  .trigger:focus-visible { outline: 2px solid var(--accent); outline-offset: 2px; }
  .trigger svg { width: 18px; height: 18px; }
  .menu {
    position: absolute; right: 0; top: calc(100% + 8px); z-index: 50; min-width: 190px;
    list-style: none; margin: 0; padding: 6px; background: var(--card);
    border-radius: 16px; box-shadow: 0 4px 0 var(--edge), 0 18px 40px -16px rgb(0 0 0 / 0.35);
    animation: drop 0.18s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .menu a {
    display: flex; justify-content: space-between; align-items: center; gap: 16px;
    padding: 9px 12px; border-radius: 10px; text-decoration: none; font-size: 15px; color: var(--muted);
  }
  .menu a:hover { background: var(--soft); color: var(--fg); }
  .menu a.active { color: var(--fg); font-weight: 600; }
  .menu small { font-family: ui-monospace, monospace; font-size: 11px; text-transform: uppercase; opacity: 0.6; }
  @keyframes drop { from { opacity: 0; transform: translateY(-6px); } }
</style>
