---
import Layout from './Layout.astro';
import TaskTile from './TaskTile.astro';
import { formatDate, useT, type Locale } from '../i18n';
import { links } from '../links';

interface Props { locale: Locale }
const { locale } = Astro.props;
const t = useT(locale);

const todo = { name: t('status.todo'), color: '#e5ac00', dark: true };
const progress = { name: t('status.progress'), color: '#2f9fd6' };
const done = { name: t('status.done'), color: '#2fa866' };
const urgent = t('status.urgent');


// October 2026 starts on Thursday.
const monthCells: (number | null)[] = [null, null, null, ...Array.from({ length: 31 }, (_, i) => i + 1), null];
const monthChips: Record<number, { k: string; c: string }> = {
  6: { k: 'design', c: '#2f9fd6' },
  8: { k: 'screens', c: '#2f9fd6' },
  9: { k: 'release', c: '#2fa866' },
  13: { k: 'backup', c: '#2fa866' },
  15: { k: 'review', c: '#2f9fd6' },
  19: { k: 'payment', c: '#e5ac00' },
  22: { k: 'gym', c: '#e5ac00' },
};
const kanbanCols = [
  { s: todo, cards: ['design', 'copy'] },
  { s: progress, cards: ['layout'] },
  { s: done, cards: ['logo', 'domain'] },
];
// Line icons, drawn in the same 24px grid and stroke as the rest of the page.
const platforms = [
  { label: 'iPhone', icon: '<rect x="7" y="2.5" width="10" height="19" rx="2.5"/><path d="M11 5h2"/>' },
  { label: 'iPad', icon: '<rect x="4" y="2.5" width="16" height="19" rx="2.5"/><path d="M11 18.5h2"/>' },
  { label: 'Mac', icon: '<rect x="3" y="4" width="18" height="12" rx="2"/><path d="M1.5 19.5h21"/><path d="M9.5 16l-.5 3.5M14.5 16l.5 3.5"/>' },
  { label: t('hero.web_platform'), icon: '<circle cx="12" cy="12" r="9"/><path d="M3 12h18M12 3a14 14 0 0 1 0 18M12 3a14 14 0 0 0 0 18"/>' },
];
// Goal card: a small left-to-right metro, two branches meeting before the finish.
const ST = {
  copy: { x: 60, y: 40, s: done }, design: { x: 60, y: 104, s: done },
  domain: { x: 230, y: 40, s: done }, screens: { x: 230, y: 104, s: progress },
  review: { x: 400, y: 72, s: todo }, release: { x: 570, y: 72, s: todo, finish: true },
} as const;
const metroLinks: [keyof typeof ST, keyof typeof ST][] = [
  ['copy', 'domain'], ['design', 'screens'], ['domain', 'review'], ['screens', 'review'], ['review', 'release'],
];
const metroEdges = metroLinks.map(([a, b]) => {
  const p = ST[a], q = ST[b], mx = (p.x + q.x) / 2;
  return { d: `M${p.x} ${p.y} C${mx} ${p.y} ${mx} ${q.y} ${q.x} ${q.y}`, color: q.s.color, done: q.s === done };
});
const metroStations = Object.entries(ST).map(([key, v]) => ({
  key, x: v.x, y: v.y, color: v.s.color, done: v.s === done, finish: 'finish' in v,
}));
// Timeline card: the week of 5–11 October 2026 (Monday first), today is the 8th.
const weekDays = Array.from({ length: 7 }, (_, i) => new Date(2026, 9, 5 + i));
// Bars per lane, already packed into rows; from/to are day columns (1-based, end exclusive).
const timelineLanes = [
  { title: t('views.goalExample'), color: 'var(--accent)', rows: [
    [{ k: 'copy', s: done, from: 1, to: 3 }, { k: 'screens', s: progress, from: 3, to: 5 }, { k: 'release', s: todo, from: 6, to: 8 }],
    [{ k: 'design', s: done, from: 1, to: 3 }, { k: 'domain', s: done, from: 3, to: 4 }, { k: 'review', s: todo, from: 5, to: 6 }],
  ] },
  { title: t('views.timelineNoGoal'), color: null, rows: [
    [{ k: 'gym', s: todo, from: 2, to: 3 }, { k: 'report', s: progress, from: 4, to: 6, drag: true }, { k: 'payRent', s: done, from: 7, to: 8 }],
  ] },
];
const mcpCommand = 'claude mcp add --transport http equilibrium http://127.0.0.1:4433/mcp';
const mcpTools = ['list_projects', 'list_tasks', 'create_tasks', 'update_task', 'create_status', 'delete_tasks'];
---

<Layout locale={locale} title={t('meta.title')} description={t('meta.description')}>
    <main id="top">
      <section class="hero wrap">
        <div class="hero-copy">
          <ul class="platforms" aria-label={t('hero.platforms')}>
            {platforms.map((pl) => (
              <li>
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={pl.icon} />
                <span>{pl.label}</span>
              </li>
            ))}
          </ul>
          <h1>{t('hero.title')}</h1>
          <p class="lead">{t('hero.lead')}</p>
          <div class="cta">
            <a href={links.appStore} class="btn btn-primary" target="_blank" rel="noopener">
              <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M16.4 12.6c0-2.6 2.1-3.8 2.2-3.9-1.2-1.8-3.1-2-3.7-2-1.6-.2-3.1.9-3.9.9-.8 0-2-.9-3.4-.9-1.7 0-3.3 1-4.2 2.6-1.8 3.1-.5 7.7 1.3 10.2.9 1.2 1.9 2.6 3.2 2.6 1.3-.1 1.8-.8 3.3-.8 1.6 0 2 .8 3.4.8 1.4 0 2.3-1.3 3.1-2.5 1-1.4 1.4-2.8 1.4-2.9-.1 0-2.7-1-2.7-4.1zM13.9 4.9c.7-.9 1.2-2.1 1.1-3.3-1 0-2.3.7-3 1.6-.7.8-1.3 2-1.1 3.2 1.1.1 2.3-.6 3-1.5z"/></svg>
              App Store
            </a>
            <a href={links.web} class="btn btn-secondary" target="_blank" rel="noopener">{t('hero.web')}</a>
          </div>
          <p class="note">{t('hero.note')}</p>
        </div>

      </section>

      <div class="showcase wrap">
        <figure class="window">
          <div class="window-bar" aria-hidden="true">
            <span></span><span></span><span></span>
            <b>Equilibrium</b>
          </div>
          <img
            src="/screenshot-graph.webp"
            width="1400"
            height="932"
            alt={t('hero.desktopAlt')}
            fetchpriority="high"
            decoding="async"
          />
        </figure>
        <div class="phone">
          <div class="phone-screen">
            <span class="island" aria-hidden="true"></span>
            <img
              src="/screenshot-calendar.webp"
              width="780"
              height="1594"
              alt={t('hero.phoneAlt')}
              fetchpriority="high"
              decoding="async"
            />
          </div>
        </div>
      </div>

      <section id="views" class="section wrap">
        <p class="eyebrow">{t('views.eyebrow')}</p>
        <h2>{t('views.title')}</h2>
        <p class="lead">{t('views.lead')}</p>

        <div class="views">
          <article class="view" data-reveal style="--i: 0">
            <div class="art month">
              {monthCells.map((c) => (
                <span class:list={['cell', { off: c === null, today: c === 8 }]}>
                  {c && <i>{c}</i>}
                  {c && monthChips[c] && <em style={`background:${monthChips[c].c}`}>{t(`tasks.${monthChips[c].k}`)}</em>}
                </span>
              ))}
            </div>
            <h3>{t('tabs.calendar')}</h3>
            <p>{t('views.calendar')}</p>
          </article>

          <article class="view" data-reveal style="--i: 1">
            <div class="art list">
              <TaskTile title={t('tasks.callMom')} status={todo} start="10:00" end="10:30" />
              <TaskTile title={t('tasks.payRent')} status={done} start="18:00" end="18:15" urgent={urgent} />
            </div>
            <h3>{t('tabs.list')}</h3>
            <p>{t('views.list')}</p>
          </article>

          <article class="view" data-reveal style="--i: 2">
            <div class="art kanban">
              {kanbanCols.map((col) => (
                <div class="col">
                  <b><span style={`background:${col.s.color}`}></span>{col.s.name}</b>
                  {col.cards.map((c) => <span class="kcard">{t(`tasks.${c}`)}</span>)}
                </div>
              ))}
            </div>
            <h3>{t('tabs.kanban')}</h3>
            <p>{t('views.kanban')}</p>
          </article>

          <article class="view" data-reveal style="--i: 3">
            <div class="art graph">
              <svg viewBox="0 0 280 150" role="img" aria-label={t('views.graphAlt')}>
                <g stroke="currentColor" stroke-width="1.5" opacity="0.35" fill="none">
                  <path d="M40 75 L110 35 L190 50 L245 95" />
                  <path d="M110 35 L125 115 L190 50" />
                  <path d="M40 75 L125 115" />
                </g>
                <circle cx="40" cy="75" r="11" fill="#2fa866" />
                <circle cx="110" cy="35" r="13" fill="#2f9fd6" />
                <circle cx="190" cy="50" r="10" fill="#e5ac00" />
                <circle cx="245" cy="95" r="9" fill="#e5ac00" />
                <circle cx="125" cy="115" r="12" fill="#2fa866" />
              </svg>
            </div>
            <h3>{t('views.graph')}</h3>
            <p>{t('views.graphText')}</p>
          </article>

          <article class="view wide" data-reveal style="--i: 4">
            <div class="art goal">
              <div class="goal-head">
                <span class="goal-ring" style="--p: 50"><i>3/6</i></span>
                <b>{t('views.goalExample')}</b>
              </div>
              <svg viewBox="0 0 640 150" role="img" aria-label={t('views.goalsAlt')}>
                {metroEdges.map((e) => (
                  <path d={e.d} stroke={e.color} stroke-width="5" fill="none" stroke-linecap="round" opacity={e.done ? 1 : 0.45} />
                ))}
                {metroStations.map((s) => (
                  <g>
                    {s.finish
                      ? <rect x={s.x - 12} y={s.y - 12} width="24" height="24" rx="7" fill="var(--accent)" />
                      : <circle cx={s.x} cy={s.y} r="9" fill={s.done ? s.color : 'var(--bg)'} stroke={s.color} stroke-width="4" />}
                    <text x={s.x} y={s.y + 30} text-anchor="middle" class="goal-label">{t(`tasks.${s.key}`)}</text>
                  </g>
                ))}
              </svg>
            </div>
            <h3>{t('views.goals')}</h3>
            <p>{t('views.goalsText')}</p>
          </article>

          <article class="view wide" data-reveal style="--i: 5">
            <div class="art timeline" role="img" aria-label={t('views.timelineAlt')}>
              <div class="tl-grid">
                <div class="tl-days">
                  {weekDays.map((d) => <span class:list={{ today: d.getDate() === 8 }}>{formatDate(locale, d, { weekday: 'short', day: 'numeric' })}</span>)}
                </div>
                {timelineLanes.map((lane) => (
                  <div class="tl-lane">
                    <b class="tl-title">{lane.color && <span style={`background:${lane.color}`}></span>}{lane.title}</b>
                    {lane.rows.map((row) => (
                      <div class="tl-row">
                        {row.map((bar) => (
                          <>
                            {bar.drag && <i class="tl-ghost" style={`grid-column:${bar.from - 1} / ${bar.to - 1}`}></i>}
                            <em class:list={['tl-bar', { drag: bar.drag, done: bar.s === done }]} style={`grid-column:${bar.from} / ${bar.to}; --c:${bar.s.color}`}>
                              {t(`tasks.${bar.k}`)}
                              {bar.drag && <u class="tl-handle"></u>}
                            </em>
                          </>
                        ))}
                      </div>
                    ))}
                  </div>
                ))}
                <i class="tl-now" style="--day: 3.45"></i>
              </div>
            </div>
            <h3>{t('views.timeline')}</h3>
            <p>{t('views.timelineText')}</p>
          </article>
        </div>
      </section>

      <section id="ai" class="section section-tint">
        <div class="wrap split">
          <div class="split-copy">
            <p class="eyebrow">{t('ai.eyebrow')}</p>
            <h2>{t('ai.title')}</h2>
            <p class="lead">{t('ai.lead')}</p>
            <ul class="points">
              {[1, 2, 3, 4].map((n) => <li><b>{t(`ai.p${n}t`)}</b> {t(`ai.p${n}`)}</li>)}
            </ul>
          </div>

          <div class="chat" data-reveal aria-label={t('ai.chatAlt')}>
            <div class="msg user">{t('ai.user')}</div>
            <div class="msg bot">
              <span class="avatar" aria-hidden="true">✦</span>
              <div class="bot-body">
                <p>{t('ai.reply')}</p>
                <div class="proposal">
                  <div class="proposal-head">
                    <span>{t('ai.proposed')}</span>
                    <span class="linked">⛓ {t('ai.linked')}</span>
                  </div>
                  <TaskTile title={t('tasks.gym')} status={todo} start="08:00" end="09:00" />
                  <TaskTile title={t('tasks.petyaCall')} status={todo} start="12:00" end="13:00" />
                  <TaskTile title={t('tasks.groceries')} status={todo} start="19:00" end="20:00" />
                  <div class="proposal-actions">
                    <span class="btn btn-primary btn-sm">{t('ai.create', { n: 3 })}</span>
                    <span class="btn-ghost">{t('ai.dismiss')}</span>
                  </div>
                </div>
              </div>
            </div>
          </div>
        </div>
      </section>

      <section id="mcp" class="section wrap split split-rev">
        <div class="split-copy">
          <p class="eyebrow">{t('mcp.eyebrow')}</p>
          <h2>{t('mcp.title')}</h2>
          <p class="lead">{t('mcp.lead')}</p>
          <p class="note">{t('mcp.note')}</p>
        </div>

        <div class="mcp" data-reveal>
          <div class="code">
            <div class="code-head">
              <span>{t('mcp.terminal')}</span>
              <button class="copy" type="button" data-copy={mcpCommand} data-done={t('mcp.copied')}>{t('mcp.copy')}</button>
            </div>
            <pre><code>{mcpCommand}</code></pre>
          </div>
          <ul class="tools">
            {mcpTools.map((name) => <li><code>{name}</code><span>{t(`mcp.tools.${name}`)}</span></li>)}
          </ul>
        </div>
      </section>

      <section id="privacy" class="section wrap">
        <p class="eyebrow">{t('privacy.eyebrow')}</p>
        <h2>{t('privacy.title')}</h2>
        <div class="facts">
          {[1, 2, 3].map((n) => (
            <div class="fact" data-reveal style={`--i: ${n - 1}`}>
              <h3>{t(`privacy.f${n}t`)}</h3>
              <p>{t(`privacy.f${n}`)}</p>
            </div>
          ))}
        </div>
      </section>

      <section class="section wrap">
        <div class="final" data-reveal>
          <img src="/logo.svg" alt="" width="64" height="64" />
          <h2>{t('final.title')}</h2>
          <p class="lead">{t('final.lead')}</p>
          <div class="cta">
            <a href={links.appStore} class="btn btn-primary" target="_blank" rel="noopener">{t('final.appStore')}</a>
            <a href={links.web} class="btn btn-secondary" target="_blank" rel="noopener">{t('final.web')}</a>
          </div>
        </div>
      </section>
    </main>

    <script>
      // The app's bounce-and-fade entrance. Content is visible without JS;
      // only blocks still below the fold get the hidden start state.
      if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const e of entries) {
              if (!e.isIntersecting) continue;
              e.target.classList.add('revealed');
              io.unobserve(e.target);
            }
          },
          { threshold: 0.15 },
        );
        for (const el of document.querySelectorAll<HTMLElement>('[data-reveal]')) {
          if (el.getBoundingClientRect().top < innerHeight) continue;
          el.classList.add('pre-reveal');
          io.observe(el);
        }
      }

      for (const button of document.querySelectorAll<HTMLButtonElement>('[data-copy]')) {
        const label = button.textContent;
        button.addEventListener('click', async () => {
          try {
            await navigator.clipboard.writeText(button.dataset.copy!);
            button.textContent = button.dataset.done!;
            setTimeout(() => (button.textContent = label), 1800);
          } catch {
            // Clipboard refused: the command stays selectable.
          }
        });
      }
    </script>
</Layout>

<style>
/* Hero */
.hero {
  display: grid; justify-items: center; text-align: center;
  padding-block: 72px 48px;
}
.hero-copy { min-width: 0; max-width: 820px; display: grid; justify-items: center; }
.hero h1 { font-size: clamp(38px, 5.6vw, 68px); line-height: 1.04; font-weight: 800; margin: 22px 0 20px; }
.hero .lead { margin-inline: auto; }
.cta { display: flex; flex-wrap: wrap; gap: 12px; margin-top: 30px; }
.hero .cta { justify-content: center; }
.note { margin-top: 14px; color: var(--muted); font-size: 14px; }
@media (max-width: 720px) { .hero { padding-block: 40px 32px; } }

.platforms {
  list-style: none; margin: 0; padding: 0;
  display: flex; flex-wrap: wrap; justify-content: center; gap: 8px;
}
.platforms li {
  display: inline-flex; align-items: center; gap: 7px;
  padding: 7px 13px 7px 10px; border-radius: 999px;
  background: var(--card); box-shadow: 0 3px 0 var(--edge); margin-bottom: 3px;
  font-size: 14px; font-weight: 600;
}
.platforms svg { width: 18px; height: 18px; color: var(--accent); flex: none; }

/* Showcase: the Mac window with the graph, the phone overlapping its corner */
.showcase { position: relative; padding-bottom: 56px; }
.window {
  margin: 0; width: min(920px, 86%); border-radius: 14px; overflow: hidden;
  background: #131112;
  box-shadow: 0 0 0 1px rgb(255 255 255 / 0.1), 0 6px 0 #0c0b0b, 0 50px 100px -40px rgb(0 0 0 / 0.55);
}
.window-bar {
  position: relative; display: flex; align-items: center; gap: 8px;
  height: 32px; padding: 0 14px; background: #1f1d1e;
  border-bottom: 1px solid #2a2829;
}
.window-bar span { width: 12px; height: 12px; border-radius: 50%; background: #ff5f57; }
.window-bar span:nth-child(2) { background: #febc2e; }
.window-bar span:nth-child(3) { background: #28c840; }
.window-bar b {
  position: absolute; left: 50%; transform: translateX(-50%);
  font-size: 13px; font-weight: 600; color: #b5b2b4;
}
.window img { display: block; width: 100%; height: auto; }
.phone {
  position: absolute; right: 0; bottom: 0; width: min(270px, 25%);
  border-radius: 46px; padding: 10px;
  /* A real phone is dark in either theme; the hairline keeps it visible on a dark page. */
  background: #1d1b1c;
  box-shadow: 0 0 0 1px rgb(255 255 255 / 0.14), 0 6px 0 #0c0b0b, 0 40px 80px -30px rgb(0 0 0 / 0.5);
}
.phone-screen {
  position: relative; border-radius: 37px; overflow: hidden;
  background: #ffffff; padding-top: 38px;
}
.island {
  position: absolute; top: 9px; left: 50%; transform: translateX(-50%);
  width: 30%; height: 24px; border-radius: 999px; background: #1d1b1c;
}
.phone-screen img { display: block; width: 100%; height: auto; }
@media (max-width: 720px) {
  /* The phone is taller than the window here: hang it from the top and
     reserve the part that sticks out below (phone ≈ 0.95W, window ≈ 0.67W). */
  .showcase { padding-bottom: calc(28vw + 32px); }
  .window { width: 100%; border-radius: 10px; }
  .window-bar { height: 24px; padding: 0 10px; gap: 6px; }
  .window-bar span { width: 9px; height: 9px; }
  .window-bar b { font-size: 11px; }
  .phone { width: 44%; right: 6px; top: 22px; bottom: auto; border-radius: 30px; padding: 6px; }
  .phone-screen { border-radius: 25px; padding-top: 26px; }
  .island { top: 6px; height: 16px; }
}

/* Sections */
.section { padding-block: 88px; }
.section > h2, .split-copy h2 { font-size: clamp(30px, 3.8vw, 44px); line-height: 1.1; font-weight: 800; margin: 12px 0 16px; }
.section-tint { background: var(--card); }
@media (max-width: 720px) { .section { padding-block: 64px; } }

/* Views */
.views { display: grid; grid-template-columns: repeat(2, 1fr); gap: 20px; margin-top: 44px; }
@media (max-width: 820px) { .views { grid-template-columns: 1fr; } }
.view {
  background: var(--card); border-radius: 24px; padding: 20px 20px 24px;
  box-shadow: 0 4px 0 var(--edge); margin-bottom: 4px; min-width: 0;
}
.view h3 { font-size: 22px; margin: 18px 0 6px; }
.view p { color: var(--muted); }
.art {
  background: var(--bg); border-radius: 16px; padding: 12px; height: 210px; overflow: hidden;
  --card-face: var(--card);
}
.month { display: grid; grid-template-columns: repeat(7, 1fr); gap: 4px; align-content: start; }
.cell {
  background: var(--soft); border-radius: 7px; height: 34px; padding: 3px 4px;
  display: grid; align-content: start; gap: 2px; min-width: 0; font-size: 10px;
}
.cell.off { background: repeating-linear-gradient(135deg, transparent 0 5px, var(--soft) 5px 6px); }
.cell.today { outline: 1.5px solid var(--fg); }
.cell i { font-style: normal; color: var(--muted); }
.cell em {
  font-style: normal; color: #fff; font-weight: 600; font-size: 8.5px; line-height: 1;
  padding: 2px 3px; border-radius: 3px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;
}
.list { display: grid; gap: 10px; align-content: center; }
.kanban { display: grid; grid-template-columns: repeat(3, 1fr); gap: 8px; }
.col { background: var(--soft); border-radius: 12px; padding: 8px; display: grid; gap: 6px; align-content: start; min-width: 0; }
.col b { display: flex; align-items: center; gap: 6px; font-size: 12px; }
.col b span { width: 8px; height: 8px; border-radius: 50%; flex: none; }
.kcard {
  background: var(--card); border-radius: 10px; padding: 8px; font-size: 12px; font-weight: 600;
  box-shadow: 0 3px 0 var(--edge); margin-bottom: 3px;
}
.graph { display: grid; place-items: center; color: var(--fg); }
.view.wide { grid-column: 1 / -1; }
.art.goal { height: auto; display: grid; gap: 4px; padding: 14px 16px 6px; overflow-x: auto; }
.goal-head { display: flex; align-items: center; gap: 10px; font-size: 15px; }
.goal-ring {
