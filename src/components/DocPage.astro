---
/**
 * Text pages (support, privacy): one readable column in the support
 * page's layout — title, muted line, a highlighted card, then sections.
 */
import Layout from './Layout.astro';
import type { Locale } from '../i18n';

interface Props {
  locale: Locale;
  page: string;
  title: string;
  description: string;
}
const { locale, page, title, description } = Astro.props;
---

<Layout locale={locale} page={page} title={title} description={description}>
  <main class="doc wrap">
    <slot />
  </main>
</Layout>

<style>
  .doc { max-width: 760px; padding-block: 56px 88px; }
  .doc :global(h1) { font-size: clamp(32px, 4.4vw, 46px); line-height: 1.1; font-weight: 800; }
  .doc :global(.muted) { color: var(--muted); margin-top: 8px; }
  .doc :global(.card) {
    margin-top: 32px; padding: 22px 24px; border-radius: 22px;
    background: var(--card); box-shadow: 0 4px 0 var(--edge); margin-bottom: 4px;
  }
  .doc :global(.card h2) { margin-top: 0; }
  .doc :global(h2) { font-size: 24px; font-weight: 700; margin: 44px 0 10px; }
  .doc :global(h3) { font-size: 18px; font-weight: 700; margin: 26px 0 6px; }
  .doc :global(p + p), .doc :global(ul + p) { margin-top: 10px; }
  .doc :global(ul) { margin: 10px 0 0; padding-left: 22px; display: grid; gap: 6px; }
  .doc :global(a) { color: var(--accent); text-underline-offset: 3px; }
  .doc :global(.mail) { font-size: 18px; font-weight: 600; margin-top: 12px; }
  @media (max-width: 720px) { .doc { padding-block: 36px 64px; } }
</style>
